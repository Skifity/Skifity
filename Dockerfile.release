# The image GoReleaser builds around an already-compiled binary.
#
# Dockerfile at the repository root builds from source and is what `make image`
# and CI use. This one exists because GoReleaser has already cross-compiled the
# binary and only needs it packaged, which keeps a release from compiling the
# same code twice per architecture.
#
# It carries the CLI for every other platform, gzipped, as the root
# Dockerfile's image does, so /api/cli/download can hand a Mac or a Windows
# laptop the CLI from the panel itself. scripts/release-cli.sh puts them in
# dist/cli/<platform>/ as each binary is built, and .goreleaser.yaml adds that
# directory to this context.
FROM gcr.io/distroless/static-debian12:nonroot
# GoReleaser's dockers_v2 puts each platform's binary in a directory named for
# the platform, linux/amd64/skifity and linux/arm64/skifity, and builds every
# platform from one context. A bare `COPY skifity` names a file that is not
# there, which is how the first tag would have found out.
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/skifity /usr/local/bin/skifity
COPY dist/cli/$TARGETPLATFORM/ /usr/local/share/skifity/cli/
USER 65532:65532
WORKDIR /var/lib/skifity
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/skifity"]
CMD ["server"]
