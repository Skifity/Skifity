{
  "name": "skifity-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:i18n && tsc -b && npm run clean && vite build",
    "build:only": "tsc -b && npm run clean && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:ignore": "node --experimental-strip-types --no-warnings scripts/check-ignore.mjs",
    "test:e2e": "playwright test",
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist/assets',{recursive:true,force:true});fs.copyFileSync('../llms.txt','public/llms.txt')\"",
    "check:destructive": "node scripts/check-destructive.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "cn": "^0.3.0",
    "i18next": "^24.2.0",
    "i18next-browser-languagedetector": "^8.0.2",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.469.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.0",
    "react-router-dom": "^7.1.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5"
  }
}
