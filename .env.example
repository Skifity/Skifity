# Skifity configuration.
#
# Copy this to .env for local development. Everything here has a working
# default, so an empty file is a valid configuration; these are the settings
# worth knowing about.
#
# Nothing secret belongs in this file in production. The master key lives in
# its own file (SKIFITY_MASTER_KEY_PATH) with 0600 permissions, and every
# credential the panel stores is encrypted with it, in the database.

# Where the panel listens. Use 127.0.0.1:8080 to keep it off the network while
# a reverse proxy is in front of it.
SKIFITY_LISTEN=:8080

# The SQLite file holding everything except the master key.
SKIFITY_DATABASE_PATH=/var/lib/skifity/panel.db

# The master key. Back this up: without it, an encrypted backup cannot be
# restored. The panel can also print a recovery key that encodes the same
# secret in a form you can write down.
SKIFITY_MASTER_KEY_PATH=/etc/skifity/master.key

# The one-time token that lets the first account be created. The installer
# writes it here and the panel deletes it once setup is done.
SKIFITY_SETUP_TOKEN_PATH=/etc/skifity/setup-token

# How users reach the panel. Used for webhook URLs and links in notifications.
# Leave it empty to work it out from the request.
SKIFITY_PUBLIC_URL=

# Talking to Kubernetes. Leave empty when the panel runs inside the cluster:
# it then uses its own ServiceAccount.
SKIFITY_KUBECONFIG=
SKIFITY_NAMESPACE=skifity-system

# The pod network the installer started this cluster with: wireguard-native or
# vxlan. It is recorded the first time the panel starts and every server added
# later is installed with the same one, because nodes on different backends
# join without an error and then never reach each other. Leave empty on a
# cluster the installer did not create, and set it in Settings -> Cluster
# instead, where it defaults to wireguard-native.
SKIFITY_POD_NETWORK=

# Where the command line tool for other platforms is kept, as
# skifity-<os>-<arch>[.exe].gz. The panel's image puts macOS, Windows and the
# other Linux architecture there, and /api/cli/download?os=darwin&arch=arm64
# serves them; the panel's own platform is always the binary it is running.
SKIFITY_CLI_DIR=/usr/local/share/skifity/cli

# debug, info, warn or error; json or text.
SKIFITY_LOG_LEVEL=info
SKIFITY_LOG_FORMAT=json

# How many reverse proxies sit in front of the panel. Only that many entries
# are trusted from X-Forwarded-For, so a client cannot forge its own address.
SKIFITY_TRUSTED_PROXY_COUNT=1

# How long a sign-in lasts without activity, and how long in-flight requests
# get when the panel is shutting down.
SKIFITY_SESSION_TTL=168h
SKIFITY_SHUTDOWN_GRACE=20s

# Development only: serve the user interface from the Vite dev server instead
# of the copy embedded in the binary, and relax cookie security so that
# http://localhost works.
SKIFITY_DEV_MODE=false
SKIFITY_DEV_FRONTEND_URL=http://127.0.0.1:5173

# For the CLI and for AI assistants talking to the panel. With these two set,
# the CLI needs no `skifity login` and no stored configuration, which is how it
# is meant to be used from CI or a container. Create a token in the panel under
# Account -> API tokens; never commit a real one.
SKIFITY_URL=http://127.0.0.1:8080
SKIFITY_TOKEN=
# Only needed when the account belongs to more than one team.
SKIFITY_TEAM=
